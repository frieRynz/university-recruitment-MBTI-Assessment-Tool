generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  EMPLOYEE
  HR
}

enum SocialScore {
  E
  I
}

enum VisionScore {
  S
  N
}

enum DecisionScore {
  T
  F
}

enum LifestyleScore {
  P
  J
}

// ---------- Models ----------

/// Internal employee. Can register, log in, take the MBTI test and review past results.
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  dob       DateTime
  gender    String
  email     String   @unique
  dept      String
  role      Role     @default(EMPLOYEE)
  password  String
  createdAt DateTime @default(now())

  mbtiResults EmployeeMBTIResult[]
}

/// Free-standing self-development test results (0..many per employee).
model EmployeeMBTIResult {
  id                  Int            @id @default(autoincrement())
  employeeId          Int
  employee            Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timestamp           DateTime       @default(now())
  socialRatingScore   SocialScore
  visionRatingScore   VisionScore
  decisionRatingScore DecisionScore
  lifestyleRatingScore LifestyleScore
  mbtiResult          String
  decisionStyle       String
  socialClarity       Float
  visionClarity       Float
  decisionClarity     Float
  lifestyleClarity    Float

  @@index([employeeId, timestamp])
}
