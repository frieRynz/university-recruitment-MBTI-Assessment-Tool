# PostgreSQL connection. NOTE: host port is 5433 (local 5432 may be occupied by a system Postgres).
DATABASE_URL="postgresql://mbti:mbti_secret@localhost:5433/mbti_db?schema=public"

# Session/JWT signing secret (change in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used in stubbed email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" only when serving over HTTPS in production
COOKIE_SECURE="false"
